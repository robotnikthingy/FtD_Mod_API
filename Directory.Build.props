<Project>
  <!--
    Shared build settings for the FtD Modding API and every mod in this repository.
    Override any path on the command line, e.g.
      dotnet build -p:FtdManaged="D:\Games\From The Depths\From_The_Depths_Data\Managed"
  -->
  <PropertyGroup>
    <!-- Same target as the official ExampleMod that ships with the game. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML comments on internals are not worth a warning each. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <FtdManaged Condition="'$(FtdManaged)' == ''">C:\Program Files (x86)\Steam\steamapps\common\From The Depths\From_The_Depths_Data\Managed</FtdManaged>
    <FtdModsDir Condition="'$(FtdModsDir)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.MyDocuments))\From The Depths\Mods</FtdModsDir>

    <!-- Set to false to build without copying into the game's Mods folder. -->
    <FtdDeploy Condition="'$(FtdDeploy)' == ''">true</FtdDeploy>

    <!-- Harmony ships with the API; mods reference this copy and must not bundle their own. -->
    <FtdHarmonyDll>$(MSBuildThisFileDirectory)FtdModApi\lib\0Harmony.dll</FtdHarmonyDll>
  </PropertyGroup>

  <!-- Game assemblies: referenced only, never copied - the game already has them loaded. -->
  <ItemGroup>
    <Reference Include="Core"><HintPath>$(FtdManaged)\Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Common"><HintPath>$(FtdManaged)\Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Modding"><HintPath>$(FtdManaged)\Modding.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Ftd"><HintPath>$(FtdManaged)\Ftd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GridCasts"><HintPath>$(FtdManaged)\GridCasts.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="DataManagement"><HintPath>$(FtdManaged)\DataManagement.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Localisation"><HintPath>$(FtdManaged)\Localisation.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Ui"><HintPath>$(FtdManaged)\Ui.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="NetInfrastructure"><HintPath>$(FtdManaged)\NetInfrastructure.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Breadboards"><HintPath>$(FtdManaged)\Breadboards.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Ai"><HintPath>$(FtdManaged)\Ai.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="FtdLua"><HintPath>$(FtdManaged)\FtdLua.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MoonSharp.Interpreter"><HintPath>$(FtdManaged)\MoonSharp.Interpreter.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="StrategicAi"><HintPath>$(FtdManaged)\StrategicAi.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(FtdManaged)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(FtdManaged)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(FtdManaged)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(FtdManaged)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(FtdManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
